{
  "id": "k8s",
  "version": "0.0.1",
  "description": "Read-only namespaced Kubernetes diagnostics",
  "requiredResourceKinds": [
    "k8s"
  ],
  "requiredGrants": [
    "read"
  ],
  "tools": [
    {
      "name": "get",
      "description": "Read allowed namespaced resources",
      "effect": "read",
      "schema": "kube"
    },
    {
      "name": "describe",
      "description": "Describe allowed namespaced resources",
      "effect": "read",
      "schema": "kube"
    },
    {
      "name": "events",
      "description": "Read namespaced events",
      "effect": "read",
      "schema": "empty"
    },
    {
      "name": "logs",
      "description": "Read bounded Pod logs",
      "effect": "read",
      "schema": "kubeLogs"
    }
  ],
  "inputSchemas": {
    "get": "kube",
    "describe": "kube",
    "events": "empty",
    "logs": "kubeLogs"
  },
  "effectPolicies": {
    "get": "read",
    "describe": "read",
    "events": "read",
    "logs": "read"
  },
  "verificationProfiles": [],
  "adapterFactory": "k8s"
}
