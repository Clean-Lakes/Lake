{
  "id": "ssh",
  "version": "0.0.1",
  "description": "Verified SSH service diagnostics and controlled changes",
  "requiredResourceKinds": [
    "ssh"
  ],
  "requiredGrants": [
    "read",
    "change"
  ],
  "tools": [
    {
      "name": "host_snapshot",
      "description": "Collect Linux host facts",
      "effect": "read",
      "schema": "empty"
    },
    {
      "name": "service_status",
      "description": "Read a bound systemd unit",
      "effect": "read",
      "schema": "unit"
    },
    {
      "name": "read_log",
      "description": "Read bounded unit logs",
      "effect": "read",
      "schema": "log"
    },
    {
      "name": "read_config",
      "description": "Read a bound configuration",
      "effect": "read",
      "schema": "readConfig"
    },
    {
      "name": "propose_config",
      "description": "Freeze new configuration as a session artifact without changing the host",
      "effect": "read",
      "schema": "patch"
    },
    {
      "name": "replace_config",
      "description": "Replace a bound configuration with validation and rollback",
      "effect": "change",
      "schema": "replaceConfig"
    },
    {
      "name": "service_action",
      "description": "Perform an approved systemd service action",
      "effect": "change",
      "schema": "serviceAction"
    }
  ],
  "inputSchemas": {
    "host_snapshot": "empty",
    "service_status": "unit",
    "read_log": "log",
    "read_config": "readConfig",
    "replace_config": "replaceConfig",
    "service_action": "serviceAction",
    "propose_config": "patch"
  },
  "effectPolicies": {
    "host_snapshot": "read",
    "service_status": "read",
    "read_log": "read",
    "read_config": "read",
    "replace_config": "change",
    "service_action": "change",
    "propose_config": "read"
  },
  "verificationProfiles": [
    "http-service-v1"
  ],
  "adapterFactory": "ssh"
}
