{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../third_party/agent-sdk/node_modules/@types"
    ],
    "paths": {
      "pg": [
        "../../web-agent/node_modules/@types/pg/index.d.ts"
      ],
      "@redis/client": [
        "../../web-agent/node_modules/@redis/client/dist/index.d.ts"
      ],
      "mysql2": [
        "../../web-agent/node_modules/mysql2/typings/mysql/index.d.ts"
      ],
      "ssh2": [
        "../../third_party/agent-sdk/node_modules/@types/ssh2/index.d.ts"
      ],
      "node-pty": [
        "../../third_party/agent-sdk/node_modules/node-pty/typings/node-pty.d.ts"
      ],
      "@modelcontextprotocol/client": [
        "../../third_party/agent-sdk/node_modules/@modelcontextprotocol/client/dist/index.d.mts"
      ],
      "@modelcontextprotocol/client/stdio": [
        "../../third_party/agent-sdk/node_modules/@modelcontextprotocol/client/dist/stdio.d.mts"
      ],
      "@zcode/core": [
        "../../third_party/agent-sdk/apps/zcode-cli/packages/core/dist/index.d.ts"
      ],
      "@zcode/contracts": [
        "../../third_party/agent-sdk/apps/zcode-cli/packages/contracts/dist/index.d.ts"
      ],
      "@zcode/provider": [
        "../../third_party/agent-sdk/packages/provider/dist/index.d.ts"
      ],
      "@zcode/adapters/*": [
        "../../third_party/agent-sdk/apps/zcode-cli/packages/adapters/dist/*/index.d.ts"
      ]
    }
  },
  "include": [
    "./*.ts"
  ]
}
