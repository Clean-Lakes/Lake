{
  "name": "@zcode/lake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/contract.d.ts",
      "import": "./src/contract.ts"
    }
  },
  "scripts": {
    "build": "pnpm --dir ../../../.. --filter @zcode/services build:lake-host && tsc && node scripts/bundle-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --no-ignore src",
    "test": "node --test test/native-data*.test.mjs test/migrations.test.mjs test/vault.test.mjs test/metadata.test.mjs test/settings.test.mjs test/secrets.test.mjs test/history.test.mjs test/library.test.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "test:legacy": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@zcode/provider": "workspace:*",
    "@zcode/provider-node": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "@zcode/shared": "workspace:*",
    "@zcode/services": "workspace:*",
    "@zcode/adapters": "workspace:*",
    "@zcode/bootstrap": "workspace:*",
    "mysql2": "3.15.3",
    "pg": "8.16.3",
    "smol-toml": "1.6.1",
    "@zcode/server": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@types/node": "^25.5.0",
    "@types/pg": "8.15.5",
    "typescript": "^5.9.0"
  }
}
